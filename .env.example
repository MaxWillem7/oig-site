# Database (lokaal: postgresql://<user>@localhost:5432/oig; Vercel: wordt gezet door de Neon-koppeling)
DATABASE_URL=
# Willekeurige lange tekst: openssl rand -hex 32
PAYLOAD_SECRET=
# Volledige URL van de site, zonder / aan het eind
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Vercel Blob (wordt gezet door de Blob-koppeling). Leeg = uploads lokaal in /media
BLOB_READ_WRITE_TOKEN=
# Mailmeldingen bij formulieren (resend.com). Leeg = alleen opslaan in het CMS
RESEND_API_KEY=
RESEND_FROM=OIG website <website@onderwijsinkoopgroep.nl>
# Pas op true zetten bij livegang op het echte domein
SITE_INDEXABLE=false
# Tag Manager-container van OIG (leeg = niets laden)
NEXT_PUBLIC_GTM_ID=GTM-W9MZPHKJ
# Geheim voor de dagelijkse opruimtaak (Vercel Cron stuurt dit mee)
CRON_SECRET=
